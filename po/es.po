msgid "Screen dimming (%)"
msgstr "Oscurecimiento de la pantalla (%)"

#: prefs.js:639
msgid "Screen blur"
msgstr "Desenfoque de la pantalla"

#: prefs.js:640
msgid "0 turns it off; higher values cost more GPU while the menu is open"
msgstr ""
"0 lo desactiva; valores mayores usan más GPU mientras el menú está abierto"

#: prefs.js:645
msgid "Behavior"
msgstr "Comportamiento"

#: prefs.js:650
msgid "General"
msgstr "General"

#: prefs.js:653
msgid "Show button in the top bar"
msgstr "Mostrar botón en la barra superior"

#: prefs.js:654
msgid "Open on"
msgstr "Abrir en"

#: prefs.js:655
msgid "Monitor with the pointer"
msgstr "Monitor del puntero"

#: prefs.js:656
msgid "Primary monitor"
msgstr "Monitor principal"

