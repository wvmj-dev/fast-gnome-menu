#: extension.js:176
msgid "No actions enabled. Choose some in the extension preferences."
msgstr "Nenhuma ação ativada. Escolha algumas nas preferências da extensão."

#: extension.js:446 prefs.js:216 prefs.js:305 prefs.js:452 prefs.js:746
#: prefs.js:795
msgid "Cancel"
msgstr "Cancelar"

#: extension.js:493
#, javascript-format
msgid "Runs automatically in %d second"
msgid_plural "Runs automatically in %d seconds"
msgstr[0] "Executa automaticamente em %d segundo"
msgstr[1] "Executa automaticamente em %d segundos"

#: extension.js:719
msgid "Power Menu"
msgstr "Menu de energia"

#: extension.js:912
#, javascript-format
msgid "Could not run “%s”"
msgstr "Não foi possível executar “%s”"

#: prefs.js:58
msgid "Order and visibility"
msgstr "Ordem e visibilidade"

#: prefs.js:59
msgid "Choose which buttons appear and in which order."
msgstr "Escolha quais botões aparecem e em qual ordem."

#: prefs.js:99
#, javascript-format
msgid "Shortcut key: %s"
msgstr "Tecla de atalho: %s"

#: prefs.js:110
msgid "Move up"
msgstr "Mover para cima"

#: prefs.js:119
msgid "Move down"
msgstr "Mover para baixo"

#: prefs.js:149
msgid "Custom actions"
msgstr "Ações personalizadas"

#: prefs.js:150
msgid ""
"Run your own commands from the menu. Commands run directly, without a shell: "
"use sh -c \"…\" for pipes or variables."
msgstr ""
"Execute seus próprios comandos pelo menu. Os comandos rodam diretamente, sem "
"shell: use sh -c \"…\" para pipes ou variáveis."

#: prefs.js:159
msgid "Add custom action"
msgstr "Adicionar ação personalizada"

#: prefs.js:174
msgid "No custom actions yet"
msgstr "Nenhuma ação personalizada ainda"

#: prefs.js:192
msgid "Edit"
msgstr "Editar"

#: prefs.js:199 prefs.js:306
msgid "Delete"
msgstr "Excluir"

#: prefs.js:212
msgid "Edit Custom Action"
msgstr "Editar ação personalizada"

#: prefs.js:212
msgid "New Custom Action"
msgstr "Nova ação personalizada"

#: prefs.js:217
msgid "Save"
msgstr "Salvar"

#: prefs.js:220
msgid "Name"
msgstr "Nome"

#: prefs.js:221
msgid "Icon name (optional)"
msgstr "Nome do ícone (opcional)"

#: prefs.js:224
msgid "Command"
msgstr "Comando"

#: prefs.js:249
msgid "Give the action a name."
msgstr "Dê um nome à ação."

#: prefs.js:256
msgid "Icon not found; the default icon will be used."
msgstr "Ícone não encontrado; o ícone padrão será usado."

#: prefs.js:266
#, javascript-format
msgid "“%s” was not found in PATH."
msgstr "“%s” não foi encontrado no PATH."

#: prefs.js:270
msgid "Enter a command, with quotes balanced."
msgstr "Digite um comando, com as aspas fechadas."

#: prefs.js:301
#, javascript-format
msgid "Delete “%s”?"
msgstr "Excluir “%s”?"

#: prefs.js:330
msgid "Custom layout"
msgstr "Disposição personalizada"

#: prefs.js:331
msgid "Click the cells where buttons go; they fill in reading order"
msgstr ""
"Clique nas células onde ficam os botões; eles são preenchidos na ordem de "
"leitura"

#: prefs.js:348
#, javascript-format
msgid "Row %d, column %d"
msgstr "Linha %d, coluna %d"

#: prefs.js:361
msgid "Clear"
msgstr "Limpar"

#: prefs.js:407
#, javascript-format
msgid "%d positions, %d actions"
msgstr "%d posições, %d ações"

#: prefs.js:408
msgid "the rest go below"
msgstr "as restantes ficam abaixo"

#: prefs.js:427
msgid "Disabled"
msgstr "Desativado"

#: prefs.js:450
msgid "Press the new key combination, Esc to cancel or Backspace to disable."
msgstr ""
"Pressione a nova combinação de teclas, Esc para cancelar ou Backspace para "
"desativar."

#: prefs.js:451
msgid "Set Shortcut"
msgstr "Definir atalho"

#: prefs.js:495
msgid "Action shortcuts"
msgstr "Atalhos das ações"

#: prefs.js:496
msgid ""
"Open the menu with an action already selected; press Enter to run it. While "
"the menu is open, these shortcuts move the selection."
msgstr ""
"Abrem o menu com uma ação já selecionada; pressione Enter para executá-la. "
"Com o menu aberto, estes atalhos mudam a seleção."

#: prefs.js:522
msgid "Not shown in the menu"
msgstr "Não aparece no menu"

#: prefs.js:527
msgid "Remove shortcut"
msgstr "Remover atalho"

#: prefs.js:529
msgid "This combination already opens the menu."
msgstr "Esta combinação já abre o menu."

#: prefs.js:582
msgid "Actions"
msgstr "Ações"

#: prefs.js:592
msgid "Appearance"
msgstr "Aparência"

#: prefs.js:597
msgid "Layout and position"
msgstr "Disposição e posição"

#: prefs.js:599
msgid "Layout"
msgstr "Disposição"

#: prefs.js:600
msgid "Automatic"
msgstr "Automática"

#: prefs.js:601
msgid "Grid"
msgstr "Grade"

#: prefs.js:602
msgid "Row"
msgstr "Linha"

#: prefs.js:603
msgid "Column"
msgstr "Coluna"

#: prefs.js:604
msgid "Circle"
msgstr "Circunferência"

#: prefs.js:605
msgid "Circle with center"
msgstr "Círculo com centro"

#: prefs.js:606
msgid "Custom"
msgstr "Personalizada"

#: prefs.js:608
msgid "Buttons per row"
msgstr "Botões por linha"

#: prefs.js:620
msgid "Position"
msgstr "Posição"

#: prefs.js:621
