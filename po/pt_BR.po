msgstr "Em relação ao tamanho do botão"

#: prefs.js:588
msgid "Selected button size (%)"
msgstr "Tamanho do botão selecionado (%)"

#: prefs.js:589
msgid "100 turns the growth animation off"
msgstr "100 desativa a animação de aumento"

#: prefs.js:590
msgid "Show labels"
msgstr "Mostrar rótulos"

#: prefs.js:594
msgid "Custom highlight color"
msgstr "Cor de destaque personalizada"

#: prefs.js:595
msgid "Use this color instead of the system accent color"
msgstr "Usar esta cor em vez da cor de destaque do sistema"

#: prefs.js:631
msgid "Background"
msgstr "Fundo"

#: prefs.js:633
msgid "Panel"
msgstr "Painel"

#: prefs.js:634
msgid "Solid"
msgstr "Sólido"

#: prefs.js:635
msgid "Translucent"
msgstr "Translúcido"

#: prefs.js:636
msgid "None (buttons float)"
msgstr "Nenhum (botões flutuam)"

#: prefs.js:638
msgid "Screen dimming (%)"
msgstr "Escurecimento da tela (%)"

#: prefs.js:639
msgid "Screen blur"
msgstr "Desfoque da tela"

#: prefs.js:640
msgid "0 turns it off; higher values cost more GPU while the menu is open"
msgstr "0 desativa; valores maiores usam mais GPU enquanto o menu está aberto"

#: prefs.js:645
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:650
msgid "General"
msgstr "Geral"

#: prefs.js:653
msgid "Show button in the top bar"
msgstr "Mostrar botão na barra superior"

#: prefs.js:654
msgid "Open on"
msgstr "Abrir em"

#: prefs.js:655
msgid "Monitor with the pointer"
msgstr "Monitor do ponteiro"

#: prefs.js:656
msgid "Primary monitor"
msgstr "Monitor principal"

#: prefs.js:658
msgid "Selected when opening"
msgstr "Selecionado ao abrir"

#: prefs.js:659
msgid "First action"
msgstr "Primeira ação"

#: prefs.js:660
msgid "Last action used"
msgstr "Última ação usada"

#: prefs.js:662
msgid "Close when clicking outside"
msgstr "Fechar ao clicar fora"

#: prefs.js:665
msgid "Confirmation"
msgstr "Confirmação"

#: prefs.js:666
msgid ""
"Before running an action, show it with a countdown and the Cancel and "
"Confirm buttons."
msgstr ""
"Antes de executar uma ação, mostrá-la com uma contagem regressiva e os "
"botões Cancelar e Confirmar."

#: prefs.js:670
msgid "Ask for confirmation"
msgstr "Pedir confirmação"

#: prefs.js:671
msgid "Never"
msgstr "Nunca"

#: prefs.js:672
msgid "For every action"
msgstr "Para todas as ações"

#: prefs.js:673
msgid "Only for the selected actions"
msgstr "Somente para as ações selecionadas"

#: prefs.js:675
msgid "Countdown (seconds)"
msgstr "Contagem regressiva (segundos)"

#: prefs.js:676
msgid "When it ends, the action runs on its own"
msgstr "Ao terminar, a ação é executada automaticamente"

#: prefs.js:677
msgid "Button selected first"
msgstr "Botão selecionado primeiro"

#: prefs.js:679
msgid "Confirm"
msgstr "Confirmar"

#: prefs.js:682
msgid "Actions that ask for confirmation"
msgstr "Ações que pedem confirmação"

#: prefs.js:718
msgid "Reset All Settings"
msgstr "Restaurar todas as configurações"

#: prefs.js:722
msgid "Reset all settings?"
msgstr "Restaurar todas as configurações?"

#: prefs.js:723
msgid ""
"Every option goes back to its default and the custom actions are deleted."
msgstr ""
"Todas as opções voltam ao padrão e as ações personalizadas são excluídas."

#: prefs.js:728
msgid "Reset"
msgstr "Restaurar"

#: actions.js:15
msgid "Lock"
msgstr "Bloquear"

#: actions.js:16
