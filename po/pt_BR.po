msgid "Left"
msgstr "Esquerda"

#: prefs.js:625
msgid "Right"
msgstr "Direita"

#: prefs.js:626
msgid "Top left"
msgstr "Topo à esquerda"

#: prefs.js:627
msgid "Top right"
msgstr "Topo à direita"

#: prefs.js:628
msgid "Bottom left"
msgstr "Base à esquerda"

#: prefs.js:629
msgid "Bottom right"
msgstr "Base à direita"

#: prefs.js:631
msgid "Distance from the edge (px)"
msgstr "Distância da borda (px)"

#: prefs.js:638
msgid "Buttons"
msgstr "Botões"

#: prefs.js:640
msgid "Button size (px)"
msgstr "Tamanho do botão (px)"

#: prefs.js:641
msgid "Corner radius (px)"
msgstr "Arredondamento dos cantos (px)"

#: prefs.js:642
msgid "Space between buttons (px)"
msgstr "Espaço entre os botões (px)"

#: prefs.js:643
msgid "Icon size (%)"
msgstr "Tamanho do ícone (%)"

#: prefs.js:644
msgid "Relative to the button size"
msgstr "Em relação ao tamanho do botão"

#: prefs.js:645
msgid "Selected button size (%)"
msgstr "Tamanho do botão selecionado (%)"

#: prefs.js:646
msgid "100 turns the growth animation off"
msgstr "100 desativa a animação de aumento"

#: prefs.js:647
msgid "Show labels"
msgstr "Mostrar rótulos"

#: prefs.js:651
msgid "Custom highlight color"
msgstr "Cor de destaque personalizada"

#: prefs.js:652
msgid "Use this color instead of the system accent color"
msgstr "Usar esta cor em vez da cor de destaque do sistema"

#: prefs.js:688
msgid "Background"
msgstr "Fundo"

#: prefs.js:690
msgid "Panel"
msgstr "Painel"

#: prefs.js:691
msgid "Solid"
msgstr "Sólido"

#: prefs.js:692
msgid "Translucent"
msgstr "Translúcido"

#: prefs.js:693
msgid "None (buttons float)"
msgstr "Nenhum (botões flutuam)"

#: prefs.js:695
msgid "Screen dimming (%)"
msgstr "Escurecimento da tela (%)"

#: prefs.js:696
msgid "Screen blur"
msgstr "Desfoque da tela"

#: prefs.js:697
msgid "0 turns it off; higher values cost more GPU while the menu is open"
msgstr "0 desativa; valores maiores usam mais GPU enquanto o menu está aberto"

#: prefs.js:702
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:707
msgid "General"
msgstr "Geral"

#: prefs.js:710
msgid "Open menu"
msgstr "Abrir menu"

#: prefs.js:711
msgid "Keyboard shortcut that shows the menu"
msgstr "Atalho de teclado que exibe o menu"

#: prefs.js:715
msgid "Reset to default"
msgstr "Restaurar padrão"

#: prefs.js:719
msgid "Show button in the top bar"
msgstr "Mostrar botão na barra superior"

#: prefs.js:720
msgid "Open on"
msgstr "Abrir em"

#: prefs.js:721
msgid "Monitor with the pointer"
msgstr "Monitor do ponteiro"

#: prefs.js:722
msgid "Primary monitor"
msgstr "Monitor principal"

#: prefs.js:724
msgid "Selected when opening"
msgstr "Selecionado ao abrir"

#: prefs.js:725
msgid "First action"
msgstr "Primeira ação"

#: prefs.js:726
msgid "Last action used"
msgstr "Última ação usada"

#: prefs.js:728
msgid "Close when clicking outside"
msgstr "Fechar ao clicar fora"

#: prefs.js:733
msgid "Confirmation"
msgstr "Confirmação"

#: prefs.js:734
msgid ""
"Before running an action, show it with a countdown and the Cancel and "
"Confirm buttons."
msgstr ""
"Antes de executar uma ação, mostrá-la com uma contagem regressiva e os "
"botões Cancelar e Confirmar."

#: prefs.js:738
msgid "Ask for confirmation"
msgstr "Pedir confirmação"

#: prefs.js:739
msgid "Never"
msgstr "Nunca"

#: prefs.js:740
msgid "For every action"
msgstr "Para todas as ações"

#: prefs.js:741
msgid "Only for the selected actions"
msgstr "Somente para as ações selecionadas"

#: prefs.js:743
msgid "Countdown (seconds)"
msgstr "Contagem regressiva (segundos)"

#: prefs.js:744
msgid "When it ends, the action runs on its own"
msgstr "Ao terminar, a ação é executada automaticamente"

#: prefs.js:745
msgid "Button selected first"
msgstr "Botão selecionado primeiro"

#: prefs.js:747
msgid "Confirm"
msgstr "Confirmar"

#: prefs.js:750
msgid "Actions that ask for confirmation"
msgstr "Ações que pedem confirmação"

#: prefs.js:786
msgid "Reset All Settings"
msgstr "Restaurar todas as configurações"

#: prefs.js:790
msgid "Reset all settings?"
msgstr "Restaurar todas as configurações?"

#: prefs.js:791
msgid ""
"Every option goes back to its default and the custom actions are deleted."
msgstr ""
"Todas as opções voltam ao padrão e as ações personalizadas são excluídas."

#: prefs.js:796
msgid "Reset"
msgstr "Restaurar"

#: actions.js:15
msgid "Lock"
msgstr "Bloquear"

#: actions.js:16
msgid "Log Out"
msgstr "Sair"

#: actions.js:17
msgid "Suspend"
msgstr "Suspender"

#: actions.js:18
msgid "Hibernate"
msgstr "Hibernar"

#: actions.js:19
msgid "Switch User"
msgstr "Trocar usuário"

#: actions.js:20
msgid "Restart"
msgstr "Reiniciar"

#: actions.js:21
msgid "Power Off"
msgstr "Desligar"
