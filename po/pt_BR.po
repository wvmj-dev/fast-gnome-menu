#: extension.js:141
msgid "No actions enabled. Choose some in the extension preferences."
msgstr "Nenhuma ação ativada. Escolha algumas nas preferências da extensão."

#: extension.js:301 prefs.js:128
msgid "Cancel"
msgstr "Cancelar"

#: extension.js:347
#, javascript-format
msgid "Runs automatically in %d second"
msgid_plural "Runs automatically in %d seconds"
msgstr[0] "Executa automaticamente em %d segundo"
msgstr[1] "Executa automaticamente em %d segundos"

#: extension.js:588
msgid "Power Menu"
msgstr "Menu de energia"

#: prefs.js:15
msgid "Actions"
msgstr "Ações"

#: prefs.js:16
msgid "Choose which buttons appear and in which order."
msgstr "Escolha quais botões aparecem e em qual ordem."

#: prefs.js:44
#, javascript-format
msgid "Shortcut key: %s"
msgstr "Tecla de atalho: %s"

#: prefs.js:53
msgid "Move up"
msgstr "Mover para cima"

#: prefs.js:62
msgid "Move down"
msgstr "Mover para baixo"

#: prefs.js:92
msgid "Open menu"
msgstr "Abrir menu"

#: prefs.js:93
msgid "Keyboard shortcut that shows the menu"
msgstr "Atalho de teclado que exibe o menu"

#: prefs.js:100
msgid "Disabled"
msgstr "Desativado"

#: prefs.js:109
msgid "Reset to default"
msgstr "Restaurar padrão"

#: prefs.js:125
msgid "Set Shortcut"
msgstr "Definir atalho"

#: prefs.js:126
msgid "Press the new key combination, Esc to cancel or Backspace to disable."
msgstr ""
"Pressione a nova combinação de teclas, Esc para cancelar ou Backspace para "
"desativar."

#: prefs.js:164
msgid "General"
msgstr "Geral"

#: prefs.js:171
msgid "Appearance"
msgstr "Aparência"

#: prefs.js:207
msgid "Layout"
msgstr "Disposição"

#: prefs.js:208
msgid "Automatic"
msgstr "Automática"

#: prefs.js:208
msgid "Grid"
msgstr "Grade"

#: prefs.js:209
msgid "Buttons per row"
msgstr "Botões por linha"

#: prefs.js:215
msgid "Button size (px)"
msgstr "Tamanho do botão (px)"

#: prefs.js:216
msgid "Corner radius (px)"
msgstr "Arredondamento dos cantos (px)"

#: prefs.js:217
msgid "Background dimming (%)"
msgstr "Escurecimento do fundo (%)"

#: prefs.js:218
msgid "Show labels"
msgstr "Mostrar rótulos"

#: prefs.js:221
msgid "Confirmation"
msgstr "Confirmação"

#: prefs.js:222
msgid ""
"Before running an action, show it with a countdown and the Cancel and "
"Confirm buttons."
msgstr "Antes de executar uma ação, mostrá-la com uma contagem regressiva e os botões Cancelar e Confirmar."

#: prefs.js:226
msgid "Ask for confirmation"
msgstr "Pedir confirmação"

#: prefs.js:227
msgid "Never"
msgstr "Nunca"

#: prefs.js:228
msgid "For every action"
msgstr "Para todas as ações"

#: prefs.js:229
msgid "Only for the selected actions"
msgstr "Somente para as ações selecionadas"

#: prefs.js:231
msgid "Countdown (seconds)"
msgstr "Contagem regressiva (segundos)"

#: prefs.js:232
msgid "When it ends, the action runs on its own"
msgstr "Ao terminar, a ação é executada automaticamente"

#: prefs.js:234
msgid "Actions that ask for confirmation"
msgstr "Ações que pedem confirmação"

#: prefs.js:258
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:262
msgid "Show button in the top bar"
msgstr "Mostrar botão na barra superior"

#: actions.js:10
msgid "Lock"
msgstr "Bloquear"

#: actions.js:11
msgid "Log Out"
msgstr "Sair"

#: actions.js:12
msgid "Suspend"
msgstr "Suspender"

#: actions.js:13
msgid "Switch User"
msgstr "Trocar usuário"

#: actions.js:14
msgid "Restart"
msgstr "Reiniciar"

#: actions.js:15
msgid "Power Off"
msgstr "Desligar"
